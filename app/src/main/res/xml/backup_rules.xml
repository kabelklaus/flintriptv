<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Include all SharedPreferences files first, then exclude sensitive ones -->
    <include domain="sharedpref" path="."/>
    
    <!-- Explicitly exclude sensitive credentials -->
    <exclude domain="sharedpref" path="credentials_prefs.xml"/>
    
    <!-- Optional: Cache can be excluded (will be regenerated) -->
    <exclude domain="sharedpref" path="iptv_cache_prefs.xml"/>
</full-backup-content>